<!DOCTYPE node PUBLIC
"-//freedesktop//DTD D-BUS Object Introspection 1.0//EN"
"http://www.freedesktop.org/standards/dbus/1.0/introspect.dtd">
<node name="/">
  <interface name="org.batocera.Hotkeygen">
    <method name="GetDetails">
      <arg direction="out" type="((sa{sv})a((ssss)(a{ts}a{ts})))" />
    </method>
    <method name="GetDeviceMappingConfig">
      <arg direction="out" type="a{sa{ss}}" />
    </method>
    <method name="GetSystemDefaultMappingConfig">
      <arg direction="out" type="(a{ss}a{ss})" />
    </method>
    <method name="Reload" />
    <method name="RemoveDeviceMappingConfig">
      <arg name="filename" direction="in" type="s" />
      <arg name="key" direction="in" type="s" />
    </method>
    <method name="ResetMousePosition" />
    <method name="SendHotkey">
      <arg name="hotkey" direction="in" type="s" />
      <arg name="delay" direction="in" type="t" />
    </method>
    <method name="SetContext">
      <arg name="name" direction="in" type="s" />
      <arg name="keys" direction="in" type="a{sv}" />
      <arg name="include_common" direction="in" type="b" />
    </method>
    <method name="SetDefaultContext" />
    <method name="SetDeviceMappingConfig">
      <arg name="filename" direction="in" type="s" />
      <arg name="key" direction="in" type="s" />
      <arg name="action" direction="in" type="s" />
    </method>
    <property name="Context" type="(sa{sv})" access="read" />
  </interface>
</node>
